{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "mynotes",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": ["nodejs_compat"],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "my-emdash-site","database_id": "7d7c9e47-2106-4ca7-931d-e3fcceda0256",
		},
	],
	"kv_namespaces": [
		{
			"binding": "SESSION",
			"id": "19379824f1f04337a06cf68fe2ace40c",
		},
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "my-emdash-media","preview_bucket_name": "my-emdash-media",
		},
	],
	// Drives scheduled publishing, plugin cron, and maintenance (see src/worker.ts)
	"triggers": {
		"crons": ["* * * * *"],
	},
}
